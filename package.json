{
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "postinstall": "npm --workspace apps/api run prisma:generate",
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "build": "npm --workspace apps/api run build && npm --workspace apps/web run build",
    "clean": "npx rimraf node_modules apps/api/node_modules apps/web/node_modules",
    "doctor": "node scripts/doctor.js",
    "smoke": "node scripts/smoke.js",
    "build:packages": "node tools/build-packages.js",
    "lint": "eslint \"apps/api/src\" \"apps/web/src\"",
    "format": "prettier --write \"apps/**/*.{ts,tsx,json,css,md}\" \"scripts/**/*.js\" \"docs/**/*.md\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "archiver": "^7.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "typescript-eslint": "^8.59.1"
  }
}
