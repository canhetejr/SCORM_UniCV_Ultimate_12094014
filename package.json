{
  "name": "unicv-scorm-ultimate",
  "private": true,
  "workspaces": ["studio/*"],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm --workspace studio/api run dev",
    "dev:web": "npm --workspace studio/web run dev",
    "build": "npm --workspace studio/api run build && npm --workspace studio/web run build",
    "check": "npm --workspace studio/web run build && npm --workspace studio/api run build",
    "doctor": "node scripts/doctor.js",
    "smoke": "node scripts/smoke.js",
    "stop": "echo Use Ctrl+C para parar os servidores",
    "clean": "npx rimraf node_modules studio/api/node_modules studio/web/node_modules",
    "build:packages": "node build-packages.js disciplinas.csv",
    "studio:dev": "npm run dev:api",
    "studio:build": "npm --workspace studio/api run build",
    "studio:start": "npm --workspace studio/api run start",
    "studio:web:dev": "npm run dev:web",
    "studio:web:build": "npm --workspace studio/web run build",
    "studio:web:preview": "npm --workspace studio/web run preview"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "rimraf": "^6.0.0"
  }
}
