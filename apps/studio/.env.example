# ─── Supabase ───────────────────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Database (Supabase PostgreSQL) ─────────────────────────────────────────
# Transaction pooler (porta 6543) com pgbouncer=true → Prisma em produção
DATABASE_URL=postgresql://postgres.xxx:[PASSWORD]@aws-0-xx.pooler.supabase.com:6543/postgres?pgbouncer=true
# Session pooler ou direct (porta 5432) → migrations (prisma migrate)
DIRECT_URL=postgresql://postgres.xxx:[PASSWORD]@aws-0-xx.pooler.supabase.com:5432/postgres

# ─── App URLs ────────────────────────────────────────────────────────────────
# URL pública do app (usada em links do player, OAuth callbacks, LTI)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000

# Conta única (opcional — se omitido, cria/usa a primeira conta no banco)
# ACCOUNT_ID=

# ─── Vimeo OAuth ─────────────────────────────────────────────────────────────
VIMEO_CLIENT_ID=
VIMEO_CLIENT_SECRET=
VIMEO_REDIRECT_URI=http://localhost:3000/api/auth/vimeo/callback

# ─── Exportações ─────────────────────────────────────────────────────────────
# Diretório onde os ZIPs gerados são salvos (SCORM, HTML)
EXPORTS_DIR=/tmp/exports

# ─── LTI 1.3 ─────────────────────────────────────────────────────────────────
LTI_PLATFORM_ISSUER=
LTI_PLATFORM_CLIENT_ID=
LTI_PLATFORM_AUTH_LOGIN_URL=
LTI_PLATFORM_KEYSET_URL=
LTI_PLATFORM_DEPLOYMENT_ID=
LTI_TOOL_PRIVATE_KEY_PEM=
LTI_TOOL_KID=unicv-tool-1

# ─── xAPI / LRS ──────────────────────────────────────────────────────────────
LRS_ENDPOINT=
LRS_BASIC_AUTH=
