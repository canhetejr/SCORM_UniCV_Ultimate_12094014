# UniCV Studio — variáveis para docker-compose.studio.yml
# Não commite este arquivo preenchido com valores reais.
# Copie para .env apenas para rodar localmente: cp .env.studio.example .env

# Banco (compose usa serviço "db")
POSTGRES_PASSWORD=postgres

# URL pública da API (obrigatório em produção: https://api.seudominio.com)
BASE_URL=http://localhost:3001

# URL pública do player (links partilháveis no admin). Ex.: https://ava.canhete.com.br
# Se vazio, o admin usa BASE_URL. Em produção defina para o domínio público do player.
PUBLIC_BASE_URL=

# Vimeo OAuth (developer.vimeo.com/apps)
VIMEO_CLIENT_ID=
VIMEO_CLIENT_SECRET=
# Opcional; se vazio usa BASE_URL + /auth/vimeo/callback
VIMEO_REDIRECT_URI=

# Segredo para cookies (mín. 16 caracteres)
COOKIE_SECRET=troque-este-segredo-por-um-bem-grande

# Exportações — pasta persistente para ficheiros ZIP (volume no Docker)
# Default: /data/exports. API cria a pasta se não existir (mkdirp).
EXPORTS_DIR=/data/exports

# Admin — login do painel (obrigatório para proteger rotas de gestão)
# Sem estas variáveis, as rotas admin devolvem 503 até estarem definidas.
ADMIN_USER=user
ADMIN_PASSWORD=password
# Opcional: segredo para JWT do admin (se vazio, usa COOKIE_SECRET)
# ADMIN_JWT_SECRET=

# LTI 1.3 (Moodle) — opcional
LTI_PLATFORM_ISSUER=
LTI_PLATFORM_CLIENT_ID=
LTI_PLATFORM_AUTH_LOGIN_URL=
LTI_PLATFORM_KEYSET_URL=
LTI_PLATFORM_DEPLOYMENT_ID=
LTI_TOOL_PRIVATE_KEY_PEM=
LTI_TOOL_KID=unicv-tool-1

# xAPI/LRS — opcional
LRS_ENDPOINT=
LRS_BASIC_AUTH=
